# Neo4j Aura - Get from https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Supabase - Get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxx.supabase.co:5432/postgres

# OpenAI - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis - Local Docker or cloud instance
REDIS_URL=redis://localhost:6379

# Pipeline configuration
CONFIDENCE_THRESHOLD=0.80
EMBEDDING_MODEL=text-embedding-3-large
SYNTHESIS_MODEL=gpt-4o

# Application settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Mock mode - Set to "true" to use in-memory mocks instead of real services
USE_MOCKS=false
