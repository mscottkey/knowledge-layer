# Neo4j Aura - Get from https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Supabase - Get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxx.supabase.co:5432/postgres

# Google AI (Gemini) - Get from https://aistudio.google.com/apikey
# Used for both embeddings (text-embedding-004) and synthesis (gemini-2.5-flash)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (optional) - Only needed if switching synthesis model back to GPT-4o
OPENAI_API_KEY=

# Redis - Local Docker or cloud instance
REDIS_URL=redis://localhost:6379

# Pipeline configuration
CONFIDENCE_THRESHOLD=0.80
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
SYNTHESIS_MODEL=gemini-2.5-flash

# Application settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Authentication. Leave unset: required with real stores, off with mocked stores.
# Create keys with: python -m scripts.create_api_key --tenant <name-or-uuid> --name <label> --scopes read write
# AUTH_REQUIRED=true

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional price overrides for cost logging, USD per 1M tokens
# MODEL_PRICES_JSON={"gemini-2.5-flash": {"input": 0.30, "output": 2.50}}

# Mock mode - "true" uses in-memory fakes for everything instead of real services.
# MOCK_STORES mocks only Neo4j/Postgres/Redis; MOCK_MODELS mocks only embeddings and synthesis.
USE_MOCKS=false
# MOCK_STORES=false
# MOCK_MODELS=false
